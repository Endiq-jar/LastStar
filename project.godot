[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="pickup"
3d_physics/layer_4="enemy"

[physics]

3d/default_gravity=20.0
common/physics_ticks_per_second=45

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/anisotropic_filtering_level=2
textures/placeholder/placeholder_generate_mipmaps=true
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/atlas_size=1024
environment/defaults/default_clear_color=Color(0.62, 0.79, 0.93, 1)
environment/defaults/default_environment="res://default_env.tres"
