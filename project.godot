[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="pickup"
3d_physics/layer_4="enemy"

[physics]

3d/default_gravity=20.0
common/physics_ticks_per_second=45

[rendering]

; ---------------------------------------------------------------------------
; Compatibility (OpenGL ES 3.0) renderer, on purpose.
;
; The Mobile renderer needs Vulkan. Many mid-range phones - notably anything on
; a PowerVR GPU such as the Oppo F19 Pro / MediaTek Helio P95 - either lack
; Vulkan, expose only Vulkan 1.0, or ship a driver that faults on the API 34
; target. Those devices create no camera and draw a black screen, which is
; exactly the bug this project shipped with.
;
; OpenGL ES 3.0 is supported by every Android device from 2013 onwards, so the
; Compatibility renderer costs a little visual fidelity and buys a game that
; actually runs. The toon/terrain/water shaders are all written to render here
; too (custom light() and glow are supported; SSAO is not, and is disabled in
; code on this path).
; ---------------------------------------------------------------------------
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"

; 2D-only supersampling off; 3D MSAA stays light for mobile fill rate.
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0

; Shadow atlas: 2048 on mobile, not the 4096 default.
;
; The atlas is one texture whose size is fixed at boot and paid whether the
; shadows in it are pixel-perfect or full of empty space. Our whole shadow rig
; is one 190 m directional map; at the engine default of 4096 that is 64 MB of
; VRAM on a phone, spent to describe a valley that fills maybe half of it and
; to produce a contact shadow under the character that is a few dozen pixels
; wide either way. 2048 quarters the memory for no visible difference at these
; distances, and on the Compatibility renderer it also quarters the clear and
; the resolve of the shadow target every frame.
rendering/lights_and_shadows/directional_shadow/size=2048
rendering/lights_and_shadows/directional_shadow/size.mobile=2048
rendering/lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
rendering/lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=0

; Depth prepass. Compatibility has no deferred path, so translucent-free
; forward shading re-runs the fragment shader for every blade of grass that a
; later opaque surface covers. A prepass resolves depth first and lets the
; ground, the trees and the rocks reject the grass fragments hidden behind
; them before the grass shader ever runs. That is worth real milliseconds in a
; scene where the meadow is the most expensive surface on screen and most of it
; is behind a hillside.
rendering/driver/depth_prepass/enable=true

; Mesh LOD bias: keep Godot's automatic mesh LOD, but start it later so it does
; not visibly simplify the character at arm's length on a small screen.
rendering/mesh_lod/lod_change/threshold_pixels=2.0
; Android export requires ETC2/ASTC import to be enabled.
textures/default_filters/anisotropic_filtering_level=2
textures/vram_compression/import_etc2_astc=true
textures/placeholder/placeholder_generate_mipmaps=true
environment/defaults/default_clear_color=Color(0.62, 0.79, 0.93, 1)
environment/defaults/default_environment="res://default_env.tres"
