# Godot 4
.godot/
*.translation
.import/
*.import
export.cfg

# Android build template generated by --install-android-build-template
android/
build*/

# Engine builds / exports
builds/
exports/
*.pck
*.x86_64
*.exe
*.app
*.dmg
*.zip
*.apk
*.aab

# OS / editor
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Secrets — never commit
.env
*.pem
*.keystore
*.jks
*_token*
!.github/workflows/*.yml

# Android build template installed by `godot --install-android-build-template`
/android/

# The shared DEBUG signing key is deliberately tracked: every APK must carry the
# same signature or Android refuses to install an update over an existing copy.
# It is a debug key (public password "android"), never a release key.
!keys/debug.keystore

# Python bytecode (tools/ has helper scripts linted in CI)
__pycache__/
*.pyc
